# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
DEBUG=false
LOG_TYPE=console

# Swagger Documentation
SWAGGER=false

# Storage Drivers Configuration
# DRIVERS should be a JSON string containing driver configurations
# See README.md Drivers section for the full configuration format
DEFAULT_DRIVER=private
DRIVERS='{"private":{"type":"gcp","config":{"projectId":"my-project","bucketName":"my-bucket","keyFilename":"/usr/src/app/gcp-key-file/keyfile.dev.json","bucketDirectory":"","linkTtlMinutes":10,"signRequired":true}},"file":{"type":"filesystem","config":{"rootPath":"/storage","baseUrl":"http://localhost:80"}}}'

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PREFIX=tao_
ELASTICSEARCH_API_KEY=api-key
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_SYNC_REFRESH=false

MAX_UPLOAD_SIZE=25000000
