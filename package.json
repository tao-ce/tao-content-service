{
  "name": "tao-content-service",
  "version": "1.0.0",
  "description": "TAO content service",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npx --watch\" \"nodemon --inspect=0.0.0.0:9669 index.js\" ",
    "start": "node index.js",
    "watch": "nodemon index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:cov": "jest --collect-coverage",
    "coverage:html": "open-cli coverage/index.html",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "lint": "eslint -c .eslintrc.js index.js healthcheck.js src test",
    "type-check": "tsc --project tsconfig.json",
    "healthcheck": "node healthcheck.js"
  },
  "author": {
    "name": "Open Assessment Technologies S.A.",
    "url": "https://www.taotesting.com"
  },
  "license": "AGPL-3.0-only OR LicenseRef-TAO-Commercial-License",
  "keywords": [
    "TAO",
    "OAT"
  ],
  "prettier": "@oat-sa/prettier-config",
  "publishConfig": {
    "access": "restricted"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oat-sa/tao-content-service.git"
  },
  "imports": {
    "#model": "./model/*",
    "#*": "./src/*"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.1",
    "@google-cloud/storage": "^7.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv-flow": "^4.0.1",
    "etcd3": "1.1.0",
    "express": "^4.21.2",
    "express-bearer-token": "^3.0.0",
    "fast-jwt": "^5.0.6",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pino": "^8.16.2",
    "pino-http": "^8.5.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@oat-sa/eslint-config-tao": "^4.0.1",
    "@oat-sa/prettier-config": "^2.0.0",
    "@types/jest": "^29.5.14",
    "@types/express": "^5.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^28.12.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.0.1",
    "open-cli": "^7.2.0",
    "prettier": "^3.5.3",
    "quicktype": "^23.0.80",
    "supertest": "^6.3.3",
    "typescript": "^5.8.3"
  }
}
